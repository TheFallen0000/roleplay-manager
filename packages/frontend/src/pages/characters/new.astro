---
import { CharacterPage } from "@/components/character/character-page"
import BaseLayout from "@/layouts/base.astro"
import { resolveLocale } from "@/lib/locale"
import { translate } from "@workspace/shared/i18n"

export const prerender = false

const locale = resolveLocale(Astro.cookies.get("language")?.value)
---

<BaseLayout
  title={`${translate(locale, "pages.newCharacter")} - Roleplay Manager`}
>
  <CharacterPage locale={locale} client:load />
</BaseLayout>
