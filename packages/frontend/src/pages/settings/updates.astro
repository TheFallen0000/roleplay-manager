---
import { UpdatesPanel } from "@/components/updates/updates-panel"
import BaseLayout from "@/layouts/base.astro"
import { resolveLocale } from "@/lib/locale"
import { translate } from "@workspace/shared/i18n"

export const prerender = false

const locale = resolveLocale(Astro.cookies.get("language")?.value)
---

<BaseLayout title={`${translate(locale, "pages.updates")} - Roleplay Manager`}>
  <UpdatesPanel locale={locale} client:load />
</BaseLayout>
