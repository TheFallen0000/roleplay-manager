---
import { ProviderManager } from "@/components/provider/provider-manager"
import BaseLayout from "@/layouts/base.astro"
import { resolveLocale } from "@/lib/locale"
import { translate } from "@workspace/shared/i18n"

export const prerender = false

const locale = resolveLocale(Astro.cookies.get("language")?.value)
---

<BaseLayout title={`${translate(locale, "pages.providers")} - Roleplay Manager`}>
  <ProviderManager locale={locale} client:load />
</BaseLayout>
