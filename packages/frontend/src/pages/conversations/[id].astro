---
import { Chat } from "@/components/conversation/chat"
import { getConversation } from "@/lib/api/conversations"
import BaseLayout from "@/layouts/base.astro"
import { resolveLocale } from "@/lib/locale"
import { translate } from "@workspace/shared/i18n"
import type { ConversationDetail } from "@workspace/shared/types/conversation"

export const prerender = false

const { id } = Astro.params
const locale = resolveLocale(Astro.cookies.get("language")?.value)

let conversation: ConversationDetail | null = null
let error: string | null = null

if (id) {
  try {
    conversation = await getConversation(id)
  } catch (e) {
    error = e instanceof Error ? e.message : translate(locale, "common.unknownError")
  }
}
---

<BaseLayout
  title={
    conversation
      ? `${conversation.title ?? conversation.characterName} - Roleplay Manager`
      : translate(locale, "pages.conversationNotFound")
  }
>
  {
    conversation ? (
      <div class="flex h-[calc(100dvh_-_5rem_-_env(safe-area-inset-top,0px))] flex-col rounded-lg border sm:h-[calc(100dvh_-_6rem_-_env(safe-area-inset-top,0px))]">
        <Chat locale={locale} client:load conversation={conversation} />
      </div>
    ) : (
      <div class="flex items-center justify-center p-12 text-sm text-muted-foreground">
        {error ?? "Conversación no encontrada."}
      </div>
    )
  }
</BaseLayout>
