---
import { TutorialsPanel } from "@/components/tutorials/tutorials-panel"
import BaseLayout from "@/layouts/base.astro"
import { resolveLocale } from "@/lib/locale"
import { isTutorialId } from "@/lib/tutorials/catalog"
import { translate } from "@workspace/shared/i18n"

export const prerender = false

const locale = resolveLocale(Astro.cookies.get("language")?.value)
const requested = Astro.url.searchParams.get("t")
const initialTutorial =
  requested !== null && isTutorialId(requested) ? requested : null
---

<BaseLayout title={`${translate(locale, "pages.tutorials")} - Roleplay Manager`}>
  <TutorialsPanel locale={locale} initialTutorial={initialTutorial} client:load />
</BaseLayout>
