---
import "@workspace/ui/globals.css"
import { AppShell } from "@/components/layout/app-shell"
import { Welcome } from "@/components/layout/welcome"
import { resolveLocale } from "@/lib/locale"
import { ONBOARDED_COOKIE_NAME, isOnboarded } from "@/lib/onboarding"

export interface Props {
  title?: string
}

const { title = "Roleplay Manager" } = Astro.props

const locale = resolveLocale(Astro.cookies.get("language")?.value)
const onboarded = isOnboarded(
  Astro.cookies.get(ONBOARDED_COOKIE_NAME)?.value,
)
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#fbfafd" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Roleplay" />
    <title>{title}</title>
    <script is:inline>
      ;(() => {
        try {
          const theme = localStorage.getItem("theme") || "default"
          const mode = localStorage.getItem("color-mode") || "system"
          const prefersDark =
            typeof window.matchMedia === "function" &&
            window.matchMedia("(prefers-color-scheme: dark)").matches
          const dark = mode === "dark" || (mode === "system" && prefersDark)
          const root = document.documentElement
          root.dataset.theme = theme
          root.classList.toggle("dark", dark)
        } catch {
          /* localStorage unavailable — fall back to the default theme */
        }
      })()
    </script>
  </head>
  <body class="bg-background text-foreground min-h-svh">
    {
      onboarded ? (
        <AppShell locale={locale} client:load>
          <slot />
        </AppShell>
      ) : (
        <Welcome locale={locale} client:load />
      )
    }
  </body>
</html>
