---
import "@workspace/ui/globals.css"
import { AppShell } from "@/components/layout/app-shell"
import { resolveLocale } from "@/lib/locale"

export interface Props {
  title?: string
}

const { title = "Roleplay Manager" } = Astro.props

const locale = resolveLocale(Astro.cookies.get("language")?.value)
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline>
      ;(() => {
        try {
          const theme = localStorage.getItem("theme") || "default"
          const mode = localStorage.getItem("color-mode") || "system"
          const prefersDark =
            typeof window.matchMedia === "function" &&
            window.matchMedia("(prefers-color-scheme: dark)").matches
          const dark = mode === "dark" || (mode === "system" && prefersDark)
          const root = document.documentElement
          root.dataset.theme = theme
          root.classList.toggle("dark", dark)
        } catch {
          /* localStorage unavailable — fall back to the default theme */
        }
      })()
    </script>
  </head>
  <body class="bg-background text-foreground min-h-svh">
    <AppShell locale={locale} client:load>
      <slot />
    </AppShell>
  </body>
</html>
