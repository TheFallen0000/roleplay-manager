---
import { Image } from "astro:assets"
import type { ImageMetadata } from "astro"
import Icon from "../components/Icon.astro"
import { screenshots } from "../data/screenshots"
import type { Locale, TranslationKey } from "../i18n"

interface Props {
  locale: Locale
  t: (key: TranslationKey) => string
}

const { locale, t } = Astro.props
const images = screenshots[locale]

type Tab = "library" | "chat" | "phone"

const tabs: Tab[] = ["library", "chat", "phone"]

const config: Record<
  Tab,
  {
    icon: string
    label: TranslationKey
    caption: TranslationKey
    alt: TranslationKey
    image: ImageMetadata
    phone?: boolean
  }
> = {
  library: {
    icon: "book",
    label: "gallery.tab.library",
    caption: "gallery.caption.library",
    alt: "gallery.imageAlt.library",
    image: images.library,
  },
  chat: {
    icon: "chat",
    label: "gallery.tab.chat",
    caption: "gallery.caption.chat",
    alt: "gallery.imageAlt.chat",
    image: images.chat,
  },
  phone: {
    icon: "phone",
    label: "gallery.tab.phone",
    caption: "gallery.caption.phone",
    alt: "gallery.imageAlt.phone",
    image: images.galleryPhone,
    phone: true,
  },
}
---

<section class="section section--tight">
  <div class="container">
    <div class="section-head">
      <h2>{t("gallery.title")}</h2>
      <p>{t("gallery.lede")}</p>
    </div>

    <div class="gallery">
      <div class="gallery-tabs" role="tablist" aria-label="Screenshots">
        {tabs.map((tab, index) => (
          <button
            class="gallery-tab"
            type="button"
            role="tab"
            id={`tab-${tab}`}
            aria-controls={`panel-${tab}`}
            aria-selected={index === 0 ? "true" : "false"}
            tabindex={index === 0 ? "0" : "-1"}
            data-gallery-tab={tab}
          >
            <Icon name={config[tab].icon} />
            <span>{t(config[tab].label)}</span>
          </button>
        ))}
      </div>

      <div class="gallery-frame">
        {tabs.map((tab, index) => {
          const item = config[tab]
          return (
            <div
              class:list={[
                "gallery-panel",
                item.phone && "gallery-panel--phone",
              ]}
              role="tabpanel"
              id={`panel-${tab}`}
              aria-labelledby={`tab-${tab}`}
              data-gallery-panel={tab}
              hidden={index !== 0}
            >
              <Image
                src={item.image}
                widths={item.phone ? [360, 720] : [720, 1080, 1440]}
                sizes={
                  item.phone
                    ? "(max-width: 56rem) 80vw, 300px"
                    : "(max-width: 48rem) 92vw, 900px"
                }
                format="webp"
                loading="lazy"
                alt={t(item.alt)}
              />
              <div class="gallery-caption">
                <span>{t(item.caption)}</span>
                <span>{t("gallery.caption.note")}</span>
              </div>
            </div>
          )
        })}
      </div>
    </div>
  </div>
</section>
