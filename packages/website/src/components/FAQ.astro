---
import type { TranslationKey } from "../i18n"

interface Props {
  t: (key: TranslationKey) => string
}

const { t } = Astro.props
const questions = [1, 2, 3, 4, 5, 6, 7] as const
---

<section class="section section--tight">
  <div class="container">
    <div class="section-head">
      <h2>{t("faq.title")}</h2>
      <p class="lede">{t("faq.lede")}</p>
    </div>

    <div class="faq">
      {
        questions.map((question) => (
          <details>
            <summary>
              <span>{t(`faq.${question}.q` as TranslationKey)}</span>
              <span class="plus" aria-hidden="true" />
            </summary>
            <div class="answer">
              <p>{t(`faq.${question}.a` as TranslationKey)}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>
