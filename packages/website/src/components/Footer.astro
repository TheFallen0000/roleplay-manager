---
import { Image } from "astro:assets"
import face from "../assets/brand/face-96.png"
import type { Locale, TranslationKey } from "../i18n"

interface Props {
  locale: Locale
  t: (key: TranslationKey) => string
  homeHref: string
  docsHref: string
  downloadHref: string
}

const { t, homeHref, docsHref, downloadHref } = Astro.props
const year = new Date().getFullYear()
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="brand" href={homeHref}>
          <Image src={face} width={32} height={32} alt="" />
          <span class="wordmark">Roleplay Manager</span>
        </a>
        <p>{t("footer.tagline")}</p>
      </div>
      <div class="footer-col">
        <h3 id="footer-product">{t("footer.product")}</h3>
        <nav aria-labelledby="footer-product">
          <a href={`${homeHref}#features`}>{t("footer.features")}</a>
          <a href={`${homeHref}#how`}>{t("footer.about")}</a>
          <a href={downloadHref}>{t("footer.download")}</a>
        </nav>
      </div>
      <div class="footer-col">
        <h3 id="footer-docs">{t("footer.docs")}</h3>
        <nav aria-labelledby="footer-docs">
          <a href={docsHref}>{t("footer.install")}</a>
          <a href={docsHref}>{t("footer.guides")}</a>
          <a href={docsHref}>{t("footer.reference")}</a>
        </nav>
      </div>
      <div class="footer-col">
        <h3 id="footer-project">{t("footer.project")}</h3>
        <nav aria-labelledby="footer-project">
          <a href="https://github.com/TheFallen0000/roleplay-manager"
            >{t("footer.github")}</a
          >
          <a href="https://github.com/TheFallen0000/roleplay-manager/releases"
            >{t("footer.releases")}</a
          >
          <a href="https://github.com/TheFallen0000/roleplay-manager/issues"
            >{t("footer.issues")}</a
          >
          <a
            href="https://github.com/TheFallen0000/roleplay-manager/blob/master/LICENSE"
            >{t("footer.license")}</a
          >
        </nav>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© {year} Roleplay Manager · AGPL-3.0-or-later</span>
      <span>{t("footer.legal")}</span>
    </div>
  </div>
</footer>
